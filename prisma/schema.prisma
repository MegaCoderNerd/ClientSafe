generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  COMPLETED
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  externalId         String?           @unique
  name               String
  password           String?
  freelancerProjects DeliveryProject[] @relation("FreelancerProjects")
  clientProjects     DeliveryProject[] @relation("ClientProjects")
  chatMessages       ChatMessage[]
}

model DeliveryProject {
  id                     String        @id @default(cuid())
  title                  String
  description            String
  price                  Int
  currency               String
  paymentStatus          PaymentStatus @default(PENDING)
  paypalOrderId          String?
  paypalCaptureId        String?       @unique
  platformFeePercent     Int           @default(10)
  platformFeeAmount      Int?
  freelancerPayoutAmount Int?
  freelancerId           String
  clientId               String
  createdAt              DateTime      @default(now())
  paidAt                 DateTime?
  checkoutStartedAt      DateTime?
  freelancer             User          @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  client                 User          @relation("ClientProjects", fields: [clientId], references: [id])
  asset                  Asset?
  chatMessages           ChatMessage[]
}

model Asset {
  id              String          @id @default(cuid())
  projectId       String          @unique
  previewUrl      String
  previewVideoUrl String?
  demoIndexUrl    String?
  originalFileUrl String
  isUnlocked      Boolean         @default(false)
  project         DeliveryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String          @id @default(cuid())
  projectId String
  project   DeliveryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime        @default(now())
}
