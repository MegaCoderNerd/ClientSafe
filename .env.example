DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
# Local: $env:NODE_OPTIONS="--use-system-ca"; npx --yes cloudflared tunnel --url http://localhost:3000
# then create a PayPal webhook at https://<tunnel-host>/api/webhooks/paypal and paste its ID here.
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
PAYPAL_MODE="sandbox"
PLATFORM_FEE_PERCENT="10"
NEXTAUTH_SECRET="a-very-long-random-string"
# Local only. Leave this unset on Vercel, or set it to the public https origin.
# Do not copy localhost into Vercel env vars — confirmation and reset emails use this host.
NEXTAUTH_URL="http://localhost:3000"
# Optional public origin override for production (no trailing slash).
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
LOCAL_STORAGE_TOKEN="mock-local-token"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Required on Vercel for Production and Preview at build time (Project Settings → API → anon public).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Auth emails are sent over SMTP from the Vercel server (not Resend / not Supabase).
# MAIL_FROM is optional: if omitted or set to a vercel.app address, the SMTP username is used.
# Gmail: enable 2FA and use an App Password. From must be that Gmail address (free vercel.app domains cannot be the From).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-app-password"
# MAIL_FROM="ClientSafe <you@gmail.com>"
# File storage: run supabase/storage-setup.sql (buckets vault-previews + vault-private).

